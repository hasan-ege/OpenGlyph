<?xml version="1.0" encoding="utf-8"?>
<!--
  Runs as the system uid so it lands in the system_app SELinux domain, which the metroid
  device tree already allows to write the matrix-leds sysfs nodes (sepolicy/private/glyph.te).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openglyph"
    android:sharedUserId="android.uid.system">

    <permission
        android:name="org.openglyph.permission.CONTROL_MATRIX"
        android:protectionLevel="signature|privileged"
        android:label="@string/permission_control_label"
        android:description="@string/permission_control_desc" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
    <!-- Recording LED: which app opened a camera, and which uid is capturing audio. -->
    <uses-permission android:name="android.permission.CAMERA_OPEN_CLOSE_LISTENER" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <!-- Always-on Glyph: a wake-up alarm each minute keeps the clock right in deep sleep. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Settings: list launchable apps for essential notifications and per-app patterns. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Glyph Mirror toy: the rear camera on the matrix, photos into DCIM. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Music visualisation: analyse the speaker output (Visualizer on the output mix). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Solar Path toy: the last known location only; no location request is ever made. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".GlyphApplication"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <service
            android:name=".GlyphService"
            android:exported="true"
            android:directBootAware="true"
            android:permission="org.openglyph.permission.CONTROL_MATRIX">
            <intent-filter>
                <action android:name="org.openglyph.BIND" />
            </intent-filter>
        </service>

        <service
            android:name=".GlyphNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Settings > Glyph Matrix. The Settings homepage entry (with its icon chip) lives in
             packages/apps/Settings (top_level_glyph_matrix) and opens this by action. -->
        <activity
            android:name=".GlyphSettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_glyph">
            <intent-filter>
                <action android:name="org.openglyph.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
