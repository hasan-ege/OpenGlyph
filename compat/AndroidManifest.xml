<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenGlyphCompat. Apps built with Nothing's Glyph Matrix SDK look for this package name and
  service, so both are fixed by that SDK (interoperability, see docs/nothing-sdk-interface.md).
  Nothing in here is Nothing's code.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nothing.thirdparty">

    <!-- The SDK README tells apps to request this; normal, so any app that asks gets it. -->
    <permission
        android:name="com.nothing.ketchum.permission.ENABLE"
        android:protectionLevel="normal"
        android:label="@string/permission_enable_label" />

    <uses-permission android:name="org.openglyph.permission.CONTROL_MATRIX" />

    <!-- Find OpenGlyph's service. -->
    <queries>
        <package android:name="org.openglyph" />
    </queries>

    <application
        android:label="@string/app_name"
        android:directBootAware="true">

        <service
            android:name=".GlyphService"
            android:exported="true"
            android:permission="com.nothing.ketchum.permission.ENABLE">
            <intent-filter>
                <action android:name="com.nothing.thirdparty.bind_glyphservice" />
            </intent-filter>
        </service>

        <activity
            android:name=".matrix.toys.manager.ToysManagerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
