<?xml version="1.0" encoding="utf-8"?>
<!-- Development tool: shows frames from tools/generator/*.html on the real Glyph Matrix, live,
     over USB (adb forward tcp:9090 tcp:9090). Not part of the ROM. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openglyph.glyphlive">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.nothing.thirdparty" />
    </queries>
    <application android:label="@string/app_name">
        <activity android:name=".LiveActivity" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
