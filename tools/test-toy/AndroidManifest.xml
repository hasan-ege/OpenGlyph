<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openglyph.testtoy">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <queries>
        <package android:name="com.nothing.thirdparty" />
    </queries>

    <application android:label="@string/app_name">
        <service android:name=".TestToy" android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>
    </application>
</manifest>
