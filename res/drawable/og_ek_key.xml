<?xml version="1.0" encoding="utf-8"?>
<!-- The Essential Key, drawn as a brushed metal pill in a dark socket. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="70dp" />
            <solid android:color="#FF0A0A0A" />
            <stroke android:width="2dp" android:color="#FF2A2A2A" />
        </shape>
    </item>
    <item android:left="9dp" android:right="9dp" android:top="9dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <corners android:radius="62dp" />
            <gradient android:type="linear" android:angle="0"
                android:startColor="#FF3A3A3A" android:centerColor="#FF8A8A8A" android:endColor="#FF2E2E2E" />
            <stroke android:width="1dp" android:color="#FF9A9A9A" />
        </shape>
    </item>
</layer-list>
