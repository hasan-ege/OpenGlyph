<?xml version="1.0" encoding="utf-8"?>
<!-- Glyph Interface: laid out after the stock screen, as tiles (TilePreference). -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_name">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="open_glyph_enabled"
        android:title="@string/settings_main_switch"
        android:persistent="false" />

    <org.openglyph.HeroPreference android:key="hero" />

    <SeekBarPreference
        android:key="open_glyph_brightness"
        android:title="@string/settings_brightness"
        android:icon="@drawable/ic_brightness"
        android:max="255"
        app:min="8"
        app:showSeekBarValue="false"
        app:updatesContinuously="true"
        android:persistent="false" />

    <PreferenceCategory
        android:key="toys_category"
        android:title="@string/settings_toys">

        <org.openglyph.TilePreference
            android:key="open_glyph_toys"
            android:title="@string/settings_toys_tile"
            android:summary="@string/settings_toys_tile_summary"
            app:tileSwitch="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="notifications_category"
        android:title="@string/settings_notifications_category">

        <org.openglyph.TilePreference
            android:key="open_glyph_notifications"
            android:title="@string/settings_notifications"
            android:icon="@drawable/ic_og_notifications"
            app:tileHalf="true"
            app:tileSwitch="true" />

        <org.openglyph.TilePreference
            android:key="essential"
            android:title="@string/settings_essential"
            android:icon="@drawable/ic_og_essential"
            app:tileHalf="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="features_category"
        android:title="@string/settings_features">

        <org.openglyph.TilePreference
            android:key="open_glyph_flip"
            android:title="@string/settings_flip"
            android:summary="@string/settings_flip_short"
            android:icon="@drawable/ic_og_flip"
            app:tileHalf="true"
            app:tileSwitch="true" />

        <org.openglyph.TilePreference
            android:key="open_glyph_aod"
            android:title="@string/settings_aod_toy_tile"
            android:icon="@drawable/ic_glyph"
            app:tileHalf="true"
            app:tileSwitch="true" />

        <org.openglyph.TilePreference
            android:key="open_glyph_calls"
            android:title="@string/settings_calls"
            android:summary="@string/settings_calls_short"
            android:icon="@drawable/ic_og_call"
            app:tileHalf="true"
            app:tileSwitch="true" />

        <org.openglyph.TilePreference
            android:key="open_glyph_charging"
            android:title="@string/settings_charging"
            android:summary="@string/settings_charging_short"
            android:icon="@drawable/ic_og_charging"
            app:tileHalf="true"
            app:tileSwitch="true" />

        <org.openglyph.TilePreference
            android:key="open_glyph_record_led"
            android:title="@string/settings_record_led"
            android:summary="@string/settings_record_led_summary"
            android:icon="@drawable/ic_og_record"
            app:tileSwitch="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="auto_off_category"
        android:title="@string/settings_auto_off">

        <org.openglyph.TilePreference
            android:key="open_glyph_bedtime"
            android:title="@string/settings_bedtime"
            android:icon="@drawable/ic_og_bedtime"
            app:tileSwitch="true" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="footer"
        android:title="@string/settings_footer" />
</PreferenceScreen>
